#!/usr/bin/env python3
"""plasma-sensors: show your PC's temperatures in a KDE Plasma 6 panel widget.

It does two things, each optional:

1. modules: loads the motherboard sensor driver (Super I/O chip such as Nuvoton
   NCT67xx or ITE IT87xx) that many distros don't load on their own, and makes
   it load on every boot (/etc/modules-load.d/plasma-sensors.conf).
2. widget: adds a System Monitor widget to the panel with CPU and GPU
   temperatures, and more sensors (usage, chipset, NVMe, fans, RAM) in the
   popup that opens when you click it.

Everything it writes is recorded in ~/.local/state/plasma-sensors/state.json and
`plasma-sensors uninstall` undoes it.

Only the Python standard library is used.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.1.0"

# Super I/O drivers, tried in order until one finds a chip. Only one of them
# can own the chip, so we stop at the first that adds a hwmon device.
SUPERIO_MODULES = ["nct6775", "it87", "nct6683", "f71882fg", "w83627ehf"]
# Board-specific drivers that complement the Super I/O one. Each is tried on
# its own: they refuse to load on boards they don't support.
EXTRA_MODULES = ["asus_ec_sensors", "asus_wmi_sensors"]

MODULES_FILE = Path("/etc/modules-load.d/plasma-sensors.conf")
MODULES_LOAD_DIRS = [
    Path("/etc/modules-load.d"),
    Path("/run/modules-load.d"),
    Path("/usr/local/lib/modules-load.d"),
    Path("/usr/lib/modules-load.d"),
]
STATE_FILE = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    / "plasma-sensors"
    / "state.json"
)
APPLETSRC = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "plasma-org.kde.plasma.desktop-appletsrc"
)
PLASMASHELL_UNIT = "plasma-plasmashell.service"
KSYSTEMSTATS_UNIT = "plasma-ksystemstats.service"
WIDGET_PLUGIN = "org.kde.plasma.systemmonitor"

TEMP_MIN, TEMP_MAX = 15.0, 110.0  # readings outside this are unplugged inputs
CHIPSET_LABEL = re.compile(r"^(PCH_CHIP_TEMP|PCH|PCH Temp|Chipset)$", re.I)
BOARD_LABEL = re.compile(r"^(SYSTIN|Motherboard|MB Temp|System)$", re.I)

